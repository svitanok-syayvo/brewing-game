extends Node
## Autoload "GameData": read-only access to the values exported from the Data Sheet.
##
## Files in res://data/ are generated by tools/export_data.py; never edit them by hand.
## Each table is an Array of row Dictionaries keyed by the Data Sheet's column headers.
## A key that is missing from a row means the cell was empty (for example a Parameter
## that a Request does not ask for), so read optional values with row.get(key).
##
## No class_name: an autoload's name already makes it global, and a class_name with the
## same name would clash with it.

const DATA_DIR := "res://data/"

## Table name (the JSON file name without .json) -> the column that holds each row's ID.
const TABLES := {
	"ingredients": "ingredient_id",
	"tools": "tool_id",
	"supply": "ingredient_id",
	"requests": "request_id",
	"characters": "character_id",
	"parameters": "parameter_id",
	"endings": "ending_id",
}

var _rows: Dictionary[String, Array] = {}
var _by_id: Dictionary[String, Dictionary] = {}


func _ready() -> void:
	for table: String in TABLES:
		_load_table(table, TABLES[table])


## All rows of a table, in Data Sheet order. Returns an empty Array for an unknown table.
func rows(table: String) -> Array:
	if not _rows.has(table):
		push_error("GameData: unknown table '%s'" % table)
		return []
	return _rows[table]


## One row by its ID, such as row("ingredients", "ing_01"). Returns an empty Dictionary if missing.
func row(table: String, id: String) -> Dictionary:
	var index: Dictionary = _by_id.get(table, {})
	if not index.has(id):
		push_error("GameData: no row '%s' in table '%s'" % [id, table])
		return {}
	return index[id]


func _load_table(table: String, id_key: String) -> void:
	var path := DATA_DIR + table + ".json"
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		push_error("GameData: cannot read %s (%s). Run tools/export_data.py." % [path, error_string(FileAccess.get_open_error())])
		return
	var parsed: Variant = JSON.parse_string(text)
	if not parsed is Array:
		push_error("GameData: %s is not a JSON array" % path)
		return

	var table_rows: Array = []
	var index: Dictionary = {}
	for entry: Variant in parsed:
		var record: Dictionary = _whole_numbers_to_int(entry)
		table_rows.append(record)
		if record.has(id_key):
			index[record[id_key]] = record
		else:
			push_error("GameData: a row in %s has no '%s'" % [path, id_key])
	_rows[table] = table_rows
	_by_id[table] = index


## Godot's JSON parser returns every number as a float (1 becomes 1.0). States, supply,
## Days and coins are all whole numbers, so turn them back into ints for clean comparisons.
func _whole_numbers_to_int(record: Dictionary) -> Dictionary:
	for key: Variant in record:
		var value: Variant = record[key]
		if value is float and is_equal_approx(value, roundf(value)):
			record[key] = int(value)
	return record
